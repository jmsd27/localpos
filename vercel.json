{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "version": 2,
    "buildCommand": "npm ci --include=dev && npm run build",
    "functions": {
        "api/index.php": {
            "runtime": "[email protected]",
            "maxDuration": 30
        }
    },
    "routes": [
        { "src": "/build/(.*)", "dest": "/public/build/$1", "headers": { "cache-control": "public, max-age=31536000, immutable" } },
        { "src": "/icons/(.*)", "dest": "/public/icons/$1", "headers": { "cache-control": "public, max-age=604800" } },
        { "src": "/(favicon\\.ico|robots\\.txt|sw\\.js|manifest\\.webmanifest)", "dest": "/public/$1" },
        { "src": "/(.*)", "dest": "/api/index.php" }
    ],
    "crons": [
        { "path": "/cron/housekeeping", "schedule": "0 8 * * *" }
    ]
}
