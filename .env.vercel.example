# =============================================================================
#  Variables de entorno para el ESPEJO EN LA NUBE (Vercel)  ·  SYNC_ROLE=mirror
# -----------------------------------------------------------------------------
#  NO subas este archivo a Vercel. Copia estos valores en:
#    Vercel > Project > Settings > Environment Variables   (entorno "Production")
#  o con la CLI:  vercel env add NOMBRE production
#  Detalle paso a paso en docs/03-despliegue-vercel.md
# =============================================================================

APP_NAME=puntoYA
APP_ENV=production
# Genera una en local con:  php artisan key:generate --show
APP_KEY=
APP_DEBUG=false
APP_URL=https://TU-PROYECTO.vercel.app

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_MX

APP_MAINTENANCE_DRIVER=file

# Vercel captura stdout/stderr en "Runtime Logs". No hay disco persistente
# para storage/logs/laravel.log.
LOG_CHANNEL=stderr
LOG_STACK=single
LOG_LEVEL=warning
LOG_DEPRECATIONS_CHANNEL=null

# --- Rol de sincronización -------------------------------------------------
# Esta instancia SOLO recibe. Nunca envía, nunca opera el POS.
SYNC_ROLE=mirror
SYNC_CLOUD_URL=
SYNC_OUTBOX_RETENTION_DAYS=30

# --- Base de datos MySQL administrada -------------------------------------
# Vercel no tiene MySQL. Usa un MySQL 8 gestionado y con TLS. Ejemplos de
# valores para TiDB Cloud Serverless (plan gratuito, compatible con MySQL):
DB_CONNECTION=mysql
DB_HOST=gateway01.us-east-1.prod.aws.tidbcloud.com
DB_PORT=4000
DB_DATABASE=localpos_cloud
DB_USERNAME=xxxxxxxxxxxxxxx.root
DB_PASSWORD=
# Ruta al bundle de CA del sistema DENTRO del runtime de Vercel (Amazon Linux):
MYSQL_ATTR_SSL_CA=/etc/pki/tls/certs/ca-bundle.crt
# Si tu proveedor usa un certificado propio y falla la verificación, ponlo en
# false SOLO temporalmente para diagnosticar (no recomendado en producción):
# DB_SSL_VERIFY_SERVER_CERT=true

# --- Sesiones / caché / colas: todo en base de datos ---------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Cookies solo por HTTPS (Vercel siempre sirve HTTPS):
SESSION_SECURE_COOKIE=true

CACHE_STORE=database
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

MAIL_MAILER=log
MAIL_FROM_ADDRESS="espejo@localpos.app"
MAIL_FROM_NAME="${APP_NAME}"

# --- Hooks HTTP opcionales ------------------------------------------------
# CRON_SECRET lo inyecta Vercel automáticamente cuando el proyecto define
# "crons" en vercel.json. No hace falta ponerlo a mano.
#
# DEPLOY_KEY habilita POST /deploy/migrate para correr migraciones por curl
# sin abrir una shell. Déjalo vacío si prefieres migrar desde tu equipo
# (ver docs/03-despliegue-vercel.md §5). Si lo usas, que sea largo y aleatorio:
# DEPLOY_KEY=

VITE_APP_NAME="${APP_NAME}"
